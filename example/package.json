{
    "name": "vda-5050-test",
    "version": "1.0.0",
    "description": "E2E Testing of VDA 5050",
    "readme": "README.md",
    "scripts": {
        "build": "gulp build",
        "start": "node -r dotenv/config dist/vda-5050-test.js",
        "start:virtual": "cross-env VDA_5050_TEST_CONFIG=./config/vda-5050-test-virtual.config.json node -r dotenv/config dist/vda-5050-test.js",
        "broker": "vda-5050 -q broker",
        "broker:verbose": "vda-5050 -q broker --verbose"
    },
    "keywords": [
        "test",
        "end-to-end",
        "testing",
        "VDA",
        "VDA 5050",
        "Node.js",
        "javascript",
        "typescript"
    ],
    "author": "Siemens AG",
    "maintainers": [
        {
            "name": "Hubertus Hohl",
            "email": "hubertus.hohl@siemens.com"
        }
    ],
    "private": true,
    "dependencies": {
        "debug": "^4.4.3",
        "dotenv": "^18.0.10",
        "fs-extra": "^11.4.1",
        "supports-color": "^11.0.0",
        "vda-5050-cli": "^2.4.0",
        "vda-5050-lib": "^1.7.2"
    },
    "devDependencies": {
        "@types/debug": "^4.1.13",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^22.20.5",
        "cross-env": "^10.1.0",
        "gulp": "^5.0.1",
        "gulp-tslint": "^8.1.4",
        "gulp-typescript": "^5.0.1",
        "tslint": "^5.20.1",
        "typescript": "~5.9.3"
    },
    "engines": {
        "node": ">=22.13.0"
    }
}
